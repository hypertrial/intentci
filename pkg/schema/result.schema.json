{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/result-v1.json",
  "title": "IntentCI Verification Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "base_commit",
    "head_commit",
    "contract_hash",
    "requirements",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "unverified", "unknown"]
    },
    "base_commit": { "type": "string" },
    "head_commit": { "type": "string" },
    "contract_hash": { "type": "string" },
    "working_tree_dirty": { "type": "boolean" },
    "profile": { "type": "string" },
    "change_spec": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "unverified", "unknown", "not_affected"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "advisory"]
          },
          "affected_by": {
            "type": "array",
            "items": { "type": "string" }
          },
          "checks": { "type": "array" },
          "evidence": { "type": "array" },
          "findings": { "type": "array" },
          "reason": { "type": "string" }
        }
      }
    },
    "checks": { "type": "array" },
    "waivers": { "type": "array" },
    "contract_changes": { "type": "array" },
    "change_findings": { "type": "array" },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "unverified", "unknown", "waived"],
      "properties": {
        "pass": { "type": "integer" },
        "fail": { "type": "integer" },
        "unverified": { "type": "integer" },
        "unknown": { "type": "integer" },
        "waived": { "type": "integer" },
        "not_affected": { "type": "integer" },
        "checks_executed": { "type": "integer" },
        "checks_cached": { "type": "integer" }
      }
    }
  }
}
