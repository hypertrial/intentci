{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/ir-v1.json",
  "title": "IntentCI Compiled Intent IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "hash", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "requirement-v1.json" }
    }
  }
}
