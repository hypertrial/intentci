{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/verification-plan-v1.json",
  "title": "IntentCI Verification Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ir_hash", "hash", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "ir_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hash", "obligations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "hash", "verify"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "verify": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
