{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/contract-v1.json",
  "title": "IntentCI Product Contract",
  "type": "object",
  "required": ["version", "product", "requirements", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "product": {
      "type": "object",
      "required": ["name", "purpose"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "non_goals": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_base": { "type": "string", "minLength": 1 },
        "unknown_blocks": { "type": "boolean" },
        "unverified_blocks": { "type": "boolean" },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "enforcement": {
              "type": "string",
              "enum": ["advisory", "blocking"]
            },
            "confidence_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["local", "http"]
                },
                "command": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "timeout": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)$"
                }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "type", "title", "statement", "status", "severity", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "behavior",
            "invariant",
            "architecture",
            "compatibility",
            "security",
            "reliability",
            "performance",
            "operability",
            "documentation"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "deprecated"]
        },
        "severity": {
          "type": "string",
          "enum": ["blocking", "advisory"]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "verification": {
          "type": "object",
          "required": ["checks"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["all", "any"]
            },
            "checks": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "semantic": {
              "type": "string",
              "enum": ["required", "optional", "off"]
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "command"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["fast", "full"]
          }
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "cache": {
          "type": "string",
          "enum": ["off", "success"]
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusive": { "type": "boolean" },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "type": "string" },
            "path": { "type": "string" }
          }
        }
      }
    }
  }
}
