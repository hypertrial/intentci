{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/report-v1.json",
  "title": "IntentCI Stable JSON Report",
  "type": "object",
  "required": ["run_id", "created_at", "run"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "root": { "type": "string" },
    "base_commit": { "type": "string" },
    "head_commit": { "type": "string" },
    "config_hash": { "type": "string" },
    "ir_hash": { "type": "string" },
    "manifest_hash": { "type": "string" },
    "attempt_id": { "type": "string" },
    "interrupted": { "type": "boolean" },
    "document": { "$ref": "ir-v1.json" },
    "run": {
      "type": "object",
      "required": ["verdict", "requirements"],
      "properties": {
        "verdict": { "$ref": "verdict-v1.json" },
        "requirements": { "type": "array" }
      }
    },
    "provider_results": { "type": "object" },
    "repository_state": { "type": ["object", "null"] },
    "unmapped_files": { "type": "array", "items": { "type": "string" } }
  }
}
