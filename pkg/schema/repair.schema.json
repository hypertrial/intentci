{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/repair-packet-v1.json",
  "title": "IntentCI Repair Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "verdict", "failures", "attempt", "max_attempts"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "requirement_id": { "type": "string" },
    "verdict": { "$ref": "verdict-v1.json" },
    "summary": { "type": "string" },
    "intent": { "type": "string" },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "protected_paths": { "type": "array", "items": { "type": "string" } },
    "test_changes_allowed": { "type": "boolean" },
    "instructions": { "type": "array", "items": { "type": "string" } },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "obligation_id", "verdict", "reason"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "obligation_id": { "type": "string", "minLength": 1 },
          "verdict": { "$ref": "verdict-v1.json" },
          "reason": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "max_attempts": { "type": "integer", "minimum": 1 }
  }
}
