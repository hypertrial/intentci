{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentci.dev/schemas/requirement-v1.json",
  "title": "IntentCI Requirement (compiled)",
  "type": "object",
  "required": ["id", "title", "status", "priority", "intent", "obligations"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "priority": { "type": "string" },
    "intent": { "type": "string" },
    "obligations": { "type": "array", "minItems": 1 }
  }
}
